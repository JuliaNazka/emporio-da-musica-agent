# Option A (recommended, what the evaluation used): free local model with Ollama, no key.
# Install Ollama, then run: ollama pull qwen3:4b-instruct
LLM_MODEL=ollama:qwen3:4b-instruct

# Option B: Gemini API key from Google AI Studio (the free tier allows about 20 requests a day per model).
# GOOGLE_API_KEY=
# LLM_MODEL=google_genai:gemini-3.8-flash